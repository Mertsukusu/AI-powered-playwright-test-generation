{
  "name": "ai-testgen",
  "version": "1.0.0",
  "description": "AI-powered Playwright Test Generator",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd services/api && python manage.py runserver 8000",
    "dev:generator": "cd services/generator && npm run dev",
    "build": "npm run build:web",
    "build:web": "cd apps/web && npm run build",
    "lint": "npm run lint:web && npm run lint:generator",
    "lint:web": "cd apps/web && npm run lint",
    "lint:generator": "cd services/generator && npm run lint",
    "format": "npm run format:web && npm run format:generator",
    "format:web": "cd apps/web && npm run format",
    "format:generator": "cd services/generator && npm run format",
    "typecheck": "npm run typecheck:web && npm run typecheck:generator",
    "typecheck:web": "cd apps/web && npm run typecheck",
    "typecheck:generator": "cd services/generator && npm run typecheck",
    "install:all": "npm install && cd apps/web && npm install && cd ../../services/generator && npm install"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
